{% comment %}Margot Decor: "Pasująca żarówka" – products from custom.matching_bulb (list of product references); PL / EN / DE / RU.{% endcomment %}
{% liquid
  assign bulbs = product.metafields.custom.matching_bulb.value
  assign mb_lang = request.locale.iso_code | split: '-' | first
  case mb_lang
    when 'pl'
      assign t_title = 'Pasująca żarówka'
      assign t_note = 'Żarówki nie są w zestawie z lampą.'
      assign t_view = 'Zobacz'
    when 'de'
      assign t_title = 'Passendes Leuchtmittel'
      assign t_note = 'Leuchtmittel sind nicht im Lieferumfang enthalten.'
      assign t_view = 'Ansehen'
    when 'ru'
      assign t_title = 'Подходящая лампа'
      assign t_note = 'Лампы не входят в комплект светильника.'
      assign t_view = 'Смотреть'
    else
      assign t_title = 'Matching bulb'
      assign t_note = 'Bulbs are not included with the lamp.'
      assign t_view = 'View'
  endcase
%}
{% if bulbs != blank and bulbs.size > 0 %}
  <div class="md-bulb" style="margin:1.25rem 0 0;padding:1rem 0 0;border-top:1px solid rgba(0,0,0,.08);">
    <p style="margin:0 0 .6rem;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mdp-muted,#4f5c57);">{{ t_title }}</p>
    {% for bulb in bulbs limit: 3 %}
      {% if bulb != blank %}
        <a href="{{ bulb.url }}" style="display:flex;align-items:center;gap:.9rem;margin:0 0 .6rem;text-decoration:none;color:inherit;">
          {% if bulb.featured_image %}
            {{ bulb.featured_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: width: 64, height: 64, loading: 'lazy', alt: bulb.title, style: 'width:64px;height:64px;object-fit:cover;border-radius:6px;background:#f6f3ee;flex:0 0 64px;' }}
          {% endif %}
          <span style="display:flex;flex-direction:column;gap:.15rem;font-size:.95rem;line-height:1.4;">
            <span>{{ bulb.title | escape }}</span>
            <span style="color:var(--mdp-muted,#4f5c57);">{{ bulb.price | money }} · <span style="text-decoration:underline;">{{ t_view }}</span></span>
          </span>
        </a>
      {% endif %}
    {% endfor %}
    <p style="margin:.2rem 0 0;font-size:.85rem;color:var(--mdp-muted,#4f5c57);">{{ t_note }}</p>
  </div>
{% endif %}
